{
  "name": "udemy-media-player",
  "version": "1.4.0",
  "main": "src/main/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development ELECTRON_DISABLE_SECURITY_WARNINGS=true electron .",
    "dev": "concurrently -k \"pnpm run dev:vite\" \"wait-on http://localhost:5173 && pnpm run dev:electron\"",
    "build": "vite build && pnpm run build:preload",
    "build:preload": "tsc -p tsconfig.preload.json",
    "start": "electron .",
    "package": "pnpm run build && electron-builder build --mac --win --linux",
    "package:mac": "pnpm run build && electron-builder build --mac",
    "package:win": "pnpm run build && electron-builder build --win",
    "package:win:x64": "pnpm run build && electron-builder build --win --x64",
    "package:win:arm64": "pnpm run build && electron-builder build --win --arm64",
    "package:linux": "pnpm run build && electron-builder build --linux"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "A self-hosted media library for Udemy courses",
  "build": {
    "appId": "com.udemymediaplayer.app",
    "productName": "Udemy Media Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@tanstack/react-router": "^1.170.5",
    "dexie": "^4.4.2",
    "mime-types": "^3.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  }
}
